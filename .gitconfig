[user]
    name = pixelead0
    email = adangq@gmail.com
    # Descomenta estas dos líneas para firmar commits con tu llave SSH:
    # signingkey = ~/.ssh/id_ed25519.pub
[commit]
    # gpgsign = true
[gpg]
    format = ssh

[core]
    autocrlf = false
    safecrlf = false
    editor = nano
    quotepath = false
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current
    followTags = true

[fetch]
    prune = true
    pruneTags = true
    all = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[merge]
    conflictStyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default
    renames = copies

[rerere]
    enabled = true
    autoupdate = true

[help]
    autocorrect = prompt

[alias]
    # Comandos rápidos habituales
    co = checkout
    ci = commit
    st = status -sb
    br = branch
    
    # Inspección de historial
    last = log -1 HEAD --stat
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all
    
    # Revisión de cambios
    df = diff
    dfs = diff --staged
    
    # Deshacer y sincronizar
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    
    # Limpieza estricta de ramas huérfanas remotas protegiendo ramas base
    limpia-orphan = "!git fetch -p && git for-each-ref --format='%(refname:short)' refs/heads | grep -Ev '^(main|master|develop|dev)$' | while read b; do git show-ref --verify --quiet \"refs/remotes/origin/$b\" || git branch -D \"$b\"; done"


